PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eduadmin
DB_PASSWORD=eduadmin_local
DB_NAME=eduadmin
# Set to true for TiDB Cloud / other hosts that require TLS on the public endpoint.
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated extra SPA origins (Vercel production + project alias).
CLIENT_ORIGINS=https://edu-admin-red-five.vercel.app,https://edu-admin.vercel.app

# Published courses (price, lessons, preview videos) come from the AilgAdmin API.
# Production / test: https://test.ailgagro.com  (must expose GET /api/v1/public/courses)
AILG_API_URL=https://test.ailgagro.com
# Same value as PARTNER_API_KEY in AilgAdmin. Lets enrolled students open every lesson.
AILG_PARTNER_KEY=

# Chapa payments. Use a test key (CHASECK_TEST-...) from dashboard.chapa.co while developing.
CHAPA_SECRET_KEY=
CHAPA_API_URL=https://api.chapa.co/v1
# Public URL of this API so Chapa can call back after payment (optional for local work).
API_PUBLIC_URL=

# Live email via Gmail SMTP (required for career apps + newsletters to hit the inbox).
# 1) Enable 2-Step Verification on the Gmail account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-character App Password into SMTP_PASS (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tasheayansa6@gmail.com
SMTP_PASS=
SMTP_FROM=EduAdmin <tasheayansa6@gmail.com>
MAIL_NOTIFY_TO=tasheayansa6@gmail.com
