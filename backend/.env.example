PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eduadmin
DB_PASSWORD=eduadmin_local
DB_NAME=eduadmin
# Set to true for TiDB Cloud / other hosts that require TLS on the public endpoint.
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# Published courses (price, lessons, preview videos) come from the AilgAdmin API.
AILG_API_URL=http://localhost:4100
# Same value as PARTNER_API_KEY in AilgAdmin. Lets enrolled students open every lesson.
AILG_PARTNER_KEY=

# Chapa payments. Use a test key (CHASECK_TEST-...) from dashboard.chapa.co while developing.
CHAPA_SECRET_KEY=
CHAPA_API_URL=https://api.chapa.co/v1
# Public URL of this API so Chapa can call back after payment (optional for local work).
API_PUBLIC_URL=
