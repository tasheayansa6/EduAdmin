    {
      "name": "Enrollments",
      "item": [
        {
          "name": "List enrollments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/enrollments?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "enrollments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Paginated enrollments. Captures enrollmentId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('enrollment list', function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.data).to.be.an('array');",
                  "  pm.expect(j.meta).to.have.property('total');",
                  "  pm.expect(j.data.length).to.be.above(0);",
                  "  const id = String(j.data[0].id);",
                  "  pm.collectionVariables.set('enrollmentId', id);",
                  "  pm.environment.set('enrollmentId', id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get enrollment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/enrollments/{{enrollmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "enrollments",
                "{{enrollmentId}}"
              ]
            },
            "description": "Enrollment detail with progress fields when present.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('enrollment fields', function () {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d).to.be.an('object');",
                  "  pm.expect(d).to.have.property('status');",
                  "  pm.expect(d).to.have.property('userId');",
                  "  pm.expect(d).to.have.property('courseId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create enrollment (may 409 if already enrolled)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/enrollments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "enrollments"
              ]
            },
            "description": "Attempts to enroll studentId into courseId. Expect 201 or 409.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{studentIdNumber}}\",\n  \"courseId\": \"{{courseIdNumber}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sid = Number(pm.collectionVariables.get('studentId'));",
                  "const cid = Number(pm.collectionVariables.get('courseId'));",
                  "pm.request.body.raw = JSON.stringify({ userId: sid, courseId: cid });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create or conflict', function () {\n  pm.expect([201, 409, 400]).to.include(pm.response.code);\n});",
                  "if (pm.response.code === 201) {\n  pm.collectionVariables.set('enrollmentId', String(pm.response.json().data.id));\n}"
                ]
              }
            }
          ]
        }
      ]
    },
