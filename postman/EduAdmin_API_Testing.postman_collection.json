          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/enrollments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "enrollments"
              ]
            },
            "description": "Second active enrollment for same student/course returns 409 when a prior enrollment already exists.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{studentIdNumber}}\",\n  \"courseId\": \"{{courseIdNumber}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sid = Number(pm.collectionVariables.get('studentId'));",
                  "const cid = Number(pm.collectionVariables.get('courseId'));",
                  "pm.request.body.raw = JSON.stringify({ userId: sid, courseId: cid });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('conflict or validation', function () {\n  pm.expect([409, 400, 201]).to.include(pm.response.code);\n});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout then reject token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.environment.get('baseUrl');",
                  "const email = pm.environment.get('adminEmail');",
                  "const password = pm.environment.get('adminPassword');",
                  "pm.sendRequest({",
                  "  url: base + '/api/v1/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json', Accept: 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
                  "}, function (err, loginRes) {",
                  "  if (err) { throw err; }",
                  "  const token = loginRes.json().token;",
                  "  pm.variables.set('logoutToken', token);",
                  "  pm.sendRequest({",
                  "    url: base + '/api/v1/auth/logout',",
                  "    method: 'POST',",
                  "    header: { Authorization: 'Bearer ' + token, Accept: 'application/json' }",
                  "  }, function (err2, logoutRes) {",
                  "    if (err2) { throw err2; }",
                  "    pm.variables.set('logoutStatus', String(logoutRes.code));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logout returned 204', function () { pm.expect(pm.variables.get('logoutStatus')).to.eql('204'); });",
                  "pm.test('old token rejected', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{logoutToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Logs in, logs out, then verifies the previous token cannot call /auth/me."
          }
        }
